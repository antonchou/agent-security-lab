__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
.venv-*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# Runtime lab artifacts (keep directory markers)
audit/*.jsonl
approvals/*.jsonl
outbox/*.json
pins/**/*.json
pins/**/*.sha256
reports/*.md
!reports/.gitkeep
!audit/.gitkeep
!approvals/.gitkeep
!outbox/.gitkeep
!pins/.gitkeep

.env
.env.*
!.env.example

# Test fixtures under lab_fs must be tracked even though they look like .env files
!lab_fs/**/.env.fake
